{
  "name": "@solana-tdp/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo",
    "typecheck": "tsgo --noEmit",
    "sync:idl": "cp ../../apps/solana-tdp-anchor/target/idl/solana_tdp.json src/idl/solana_tdp.json",
    "sync:types": "cp ../../apps/solana-tdp-anchor/target/types/solana_tdp.ts src/types/solana_tdp.ts",
    "sync": "pnpm sync:idl && pnpm sync:types"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2"
  }
}
