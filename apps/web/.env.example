# Solana RPC endpoint (defaults to devnet)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# API backend (Cloudflare Worker for waitlist, etc.)
VITE_API_URL=http://localhost:8787

# Google Analytics (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Privy (wallet abstraction + auth)
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=  # Optional — only if using app clients

# Sentry (error tracking) — optional, leave empty to disable
VITE_SENTRY_DSN=

