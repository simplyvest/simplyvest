---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/navbar.tsx";
import { Footer } from "../components/footer.tsx";
import { WaitlistForm } from "../components/waitlist/waitlist-form.tsx";
import { WaitlistHero } from "../components/waitlist/waitlist-hero.tsx";
---

<Layout title="Waitlist — SimplyVest">
  <Navbar client:load />
  <main class="mx-auto max-w-xl px-6 pb-24 pt-32">
    <WaitlistHero client:load />
    <WaitlistForm client:load />
  </main>
  <Footer client:load />
</Layout>
