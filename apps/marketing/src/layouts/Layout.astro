---
import "../styles.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? "SimplyVest"}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-bg text-text font-sans">
    <slot />
  </body>
</html>
