{
  "name": "@solana-tdp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsgo",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply simplyvest-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply simplyvest-db --remote",
    "db:reset": "wrangler d1 execute simplyvest-db --local --command 'DROP TABLE IF EXISTS stream_events; DROP TABLE IF EXISTS streams; DROP TABLE IF EXISTS org_members; DROP TABLE IF EXISTS organizations; DROP TABLE IF EXISTS users;'"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20250501.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.8",
    "wrangler": "^4.90.0"
  }
}
