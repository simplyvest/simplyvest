{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc", "vitest"],
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "react/self-closing-comp": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-deprecated": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/.anchor/**",
    "**/test-ledger/**",
    "**/keypairs/**",
    "**/routeTree.gen.ts"
  ],
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "**/__tests__/setup.ts", "*.stories.tsx"],
      "plugins": ["vitest"],
      "env": { "vitest": true },
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["apps/api/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/solana-tdp-anchor/scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/solana-tdp-anchor/tests/**/*.test.ts"],
      "rules": {
        "vitest/require-to-throw-message": "off"
      }
    }
  ]
}
