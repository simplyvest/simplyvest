#!/bin/sh
set -e

# JS/TS linting and formatting via nano-staged
if git diff --cached --name-only --diff-filter=ACM | grep -E -q '\.(js|jsx|ts|tsx|mjs|cjs|css|md|json|yml|yaml|html|toml)$'; then
  CI=true pnpm exec nano-staged
fi

# Typecheck staged TS files (with some buffer for imports)
if git diff --cached --name-only --diff-filter=ACM | grep -E -q '\.tsx?$'; then
  CI=true pnpm --filter @solana-tdp/web check:ts
  CI=true pnpm --filter @solana-tdp/api typecheck
  CI=true pnpm --filter @solana-tdp/anchor typecheck
fi

# Rust checks if .rs files are staged
if git diff --cached --name-only --diff-filter=ACM | grep -E -q '\.rs$'; then
  cd apps/solana-tdp-anchor/programs/solana-tdp || exit 1
  cargo fmt --check
  cargo clippy --all-targets -- -D warnings
fi

