{
  "name": "solana-tdp-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "anchor:build": "cd apps/solana-tdp-anchor && anchor build",
    "sdk:sync": "pnpm --filter @solana-tdp/sdk sync",
    "sdk:build": "pnpm --filter @solana-tdp/sdk build",
    "program:build": "pnpm anchor:build && pnpm sdk:sync && pnpm sdk:build",
    "lint": "oxlint --fix .",
    "format": "oxfmt .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:ts": "pnpm --filter @solana-tdp/web check:ts",
    "check:ts:api": "pnpm --filter @solana-tdp/api typecheck",
    "check:ts:all": "pnpm check:ts && pnpm check:ts:api",
    "dev": "pnpm dev:api & pnpm dev:web",
    "dev:api": "pnpm --filter @solana-tdp/api dev",
    "dev:web": "pnpm sdk:build && pnpm --filter @solana-tdp/web dev",
    "db:generate": "pnpm --filter @solana-tdp/api db:generate",
    "db:migrate": "pnpm --filter @solana-tdp/api db:migrate",
    "db:migrate:remote": "pnpm --filter @solana-tdp/api db:migrate:remote",
    "db:reset": "pnpm --filter @solana-tdp/api db:reset",
    "deploy:api": "pnpm --filter @solana-tdp/api deploy",
    "storybook": "NODE_OPTIONS=--disable-warning=DEP0205 pnpm --filter @solana-tdp/web storybook",
    "build-storybook": "pnpm --filter @solana-tdp/web build-storybook",
    "lint:rust": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo clippy --all-targets -- -D warnings",
    "format:rust": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo fmt",
    "format:rust:check": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo fmt --check",
    "prepare": "git config core.hooksPath .hooks"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260618.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "wrangler": "^4.90.0"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,md,json,yml,yaml,html,toml}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
