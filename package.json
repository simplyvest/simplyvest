{
  "name": "solana-tdp-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "anchor:build": "cd apps/solana-tdp-anchor && anchor build",
    "sdk:sync": "pnpm --filter @solana-tdp/sdk sync",
    "sdk:build": "pnpm --filter @solana-tdp/sdk build",
    "program:build": "pnpm anchor:build && pnpm sdk:sync && pnpm sdk:build",
    "lint": "oxlint --fix .",
    "format": "oxfmt .",
    "lint:rust": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo clippy --all-targets -- -D warnings",
    "format:rust": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo fmt",
    "format:rust:check": "cd apps/solana-tdp-anchor/programs/solana-tdp && cargo fmt --check",
    "prepare": "git config core.hooksPath .hooks"
  },
  "devDependencies": {
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "wrangler": "^4.90.0"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,md,json,yml,yaml,html,toml}": "oxfmt"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.2.2"
}
